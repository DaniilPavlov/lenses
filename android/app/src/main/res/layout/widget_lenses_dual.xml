<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_brand_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_app_icon" />

        <TextView
            android:id="@+id/widget_brand_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#131413"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="lenses" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#74C3F7"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="L" />

            <TextView
                android:id="@+id/widget_days_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#74C3F7"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="12" />

            <TextView
                android:id="@+id/widget_caption_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#A3131413"
                android:textSize="10sp"
                tools:text="Days until replacement" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9CD05A"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="R" />

            <TextView
                android:id="@+id/widget_days_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#9CD05A"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="9" />

            <TextView
                android:id="@+id/widget_caption_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#A3131413"
                android:textSize="10sp"
                tools:text="Days until replacement" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
